{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-voting-results",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Results requests must reach the Worker so it can answer from KV. Without
    // this, the sample JSON baked into dist/ would shadow the live data, since
    // a matching static asset is normally served without invoking the Worker.
    "run_worker_first": ["/data/results/*"]
  },

  "kv_namespaces": [
    {
      "binding": "RESULTS",
      // Replace with the id printed by:
      //   npx wrangler kv namespace create RESULTS
      "id": "ef1be3b3b54546b49dcf7ec25ce0e0be"
    }
  ],

  // In-Worker ingest. Requires the Workers PAID plan: the free plan allows
  // 10 ms of CPU per invocation and normalizing ~40 county payloads costs well
  // over 100 ms, so on free these ticks fail with a CPU-limit error.
  //
  // ON THE FREE PLAN: delete this "triggers" block and let
  // .github/workflows/refresh-results.yml do the ingest instead. It runs the
  // same code and writes the same KV keys; the Worker is then only reading
  // from KV, which is far below the free CPU ceiling.
  //
  // Most ticks cost a single upstream request either way, because the job
  // skips the county fan-out when `asOf` has not moved. Drop to "*/2 * * * *"
  // on election night, or up to hourly once results certify.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "vars": {
    "ELECTION_ID": "20260804"
  },

  "observability": {
    "enabled": true
  }
}
