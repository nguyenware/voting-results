{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-voting-results",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Results requests must reach the Worker so it can answer from KV. Without
    // this, the sample JSON baked into dist/ would shadow the live data, since
    // a matching static asset is normally served without invoking the Worker.
    "run_worker_first": ["/data/results/*"]
  },

  "kv_namespaces": [
    {
      "binding": "RESULTS",
      // Replace with the id printed by:
      //   npx wrangler kv namespace create RESULTS
      "id": "ef1be3b3b54546b49dcf7ec25ce0e0be"
    }
  ],

  // No "triggers" block on purpose. The in-Worker cron needs the Workers PAID
  // plan: free allows 10 ms of CPU per invocation and normalizing ~40 county
  // payloads costs well over 100 ms, so those ticks would fail with a
  // CPU-limit error. .github/workflows/refresh-results.yml runs the same
  // ingest instead and writes the same KV keys, leaving this Worker only
  // reading from KV — far below the free ceiling.
  //
  // On a paid plan you can move the ingest back in-process by restoring:
  //   "triggers": { "crons": ["*/5 * * * *"] }
  // The scheduled handler in worker/index.js is still wired up for that.

  "vars": {
    "ELECTION_ID": "20260804"
  },

  "observability": {
    "enabled": true
  }
}
